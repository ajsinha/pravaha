# Project Pravaha -- the AI layer (ADR-063, docs/design/architecture/ai.md). Shipped disabled: copy to
# $PRAVAHA_HOME/conf/ai/<name>.yaml (no .example), set enabled: true, and turn the layer on with
# PRAVAHA_AI_ENABLED=true. Keys are ${ENV} placeholders only; a literal key is refused when the file is read.
type: mock
enabled: false
default-model: mock
models:
  - name: mock
    cost-per-1k-input: 0.001                # so cost limits and audit can be exercised
    cost-per-1k-output: 0.002
  - name: vectors
    kind: embedding
mock:
  # reply: "a fixed answer"                 # omit to echo the last user message
  latency-ms: 0                             # simulated delay
  # fail: "simulated outage"                # every call fails with this message
  # fail-every: 5                           # every 5th call fails
  dimensions: 8                             # embedding vector size
  rules:                                    # the first rule whose regex is found in the last user message applies
    - {match: "(?i)hello", reply: "Hi there"}
    - {match: "weather", tool: get_weather, tool-args: '{"city":"Oslo"}'}
    - {match: "boom", error: "scripted failure"}
