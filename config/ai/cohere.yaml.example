# Project Pravaha -- the AI layer (ADR-063, docs/design/architecture/ai.md). Shipped disabled: copy to
# $PRAVAHA_HOME/conf/ai/<name>.yaml (no .example), set enabled: true, and turn the layer on with
# PRAVAHA_AI_ENABLED=true. Keys are ${ENV} placeholders only; a literal key is refused when the file is read.
type: cohere
enabled: false
api-key: ${COHERE_API_KEY}                  # COHERE_API_KEY or CO_API_KEY is also read when this line is left out
# embedding-input-type: search_document
timeout: 60s
# tls:                                      # the connectors' tls.* keys (docs/guides/CONNECTOR_TLS.md): a private CA, mutual TLS, ...
#   ca: /opt/pravaha/secrets/ca.pem
# proxy:                                    # proxy.url only; proxy authentication is not built
#   url: http://proxy.corp:3128
