# Project Pravaha -- the AI layer (ADR-063, docs/design/architecture/ai.md). Shipped disabled: copy to
# $PRAVAHA_HOME/conf/ai/<name>.yaml (no .example), set enabled: true, and turn the layer on with
# PRAVAHA_AI_ENABLED=true. Keys are ${ENV} placeholders only; a literal key is refused when the file is read.
type: bedrock
enabled: false
region: us-east-1                           # also AWS_REGION / AWS_DEFAULT_REGION
# Credentials: the keys named here, else AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN in the
# environment. Profiles, SSO and instance or container roles are not read (SigV4 is signed by hand, no AWS SDK).
# aws-access-key-id: ${AWS_ACCESS_KEY_ID}
# aws-secret-access-key: ${AWS_SECRET_ACCESS_KEY}
# aws-session-token: ${AWS_SESSION_TOKEN}
# base-url: https://vpce-....bedrock-runtime.us-east-1.vpce.amazonaws.com   # an endpoint override
# embedding-input-type: search_document     # Cohere embedding models
timeout: 60s
retries: 1
# tls:                                      # the connectors' tls.* keys (docs/guides/CONNECTOR_TLS.md): a private CA, mutual TLS, ...
#   ca: /opt/pravaha/secrets/ca.pem
# proxy:                                    # proxy.url only; proxy authentication is not built
#   url: http://proxy.corp:3128
