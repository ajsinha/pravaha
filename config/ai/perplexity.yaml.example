# Project Pravaha -- the AI layer (ADR-063, docs/design/architecture/ai.md). Shipped disabled: copy to
# $PRAVAHA_HOME/conf/ai/<name>.yaml (no .example), set enabled: true, and turn the layer on with
# PRAVAHA_AI_ENABLED=true. Keys are ${ENV} placeholders only; a literal key is refused when the file is read.
type: perplexity
enabled: false
# base-url: https://api.perplexity.ai   # the vendor's address is the default
api-key: ${PERPLEXITY_API_KEY}                  # an ${ENV_NAME} placeholder only; a literal key is refused (PERPLEXITY_API_KEY is also read when this line is left out)
timeout: 60s
retries: 1
# default-model: ...                        # a catalogue model; the catalogue (ai/llm_catalog.json) is listed unless 'catalogue: false'
# models:                                   # add to or override the catalogue (a new vendor model id needs no code change)
#   - name: my-model
#     id: vendor/model-id
#     capabilities: [chat, tool-calls, json-mode]
#     cost-per-1k-input: 0.0006
#     cost-per-1k-output: 0.0024
# tls:                                      # the connectors' tls.* keys (docs/guides/CONNECTOR_TLS.md): a private CA, mutual TLS, ...
#   ca: /opt/pravaha/secrets/ca.pem
# proxy:                                    # proxy.url only; proxy authentication is not built
#   url: http://proxy.corp:3128
