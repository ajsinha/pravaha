<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy to ~/.m2/toolchains.xml.

  Pravaha builds on JDK 21 or later (ADR-062); CI builds on 21 and on 25, and this names both.
  maven-toolchains-plugin is declared but not bound: the JDK on JAVA_HOME compiles, and
  tools/jdk.sh puts one there (implementation plan P0-02e).
-->
<toolchains>
  <toolchain>
    <type>jdk</type>
    <provides><version>21</version><vendor>openjdk</vendor></provides>
    <configuration><jdkHome>/usr/lib/jvm/java-21-openjdk-amd64</jdkHome></configuration>
  </toolchain>
  <toolchain>
    <type>jdk</type>
    <provides><version>25</version><vendor>openjdk</vendor></provides>
    <configuration><jdkHome>/usr/lib/jvm/java-25-openjdk-amd64</jdkHome></configuration>
  </toolchain>
</toolchains>
