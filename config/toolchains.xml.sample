<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy to ~/.m2/toolchains.xml.

  Pravaha 2.x builds on JDK 25 only (ADR-061), so this names one JDK. maven-toolchains-plugin is
  declared but not bound: the JDK on JAVA_HOME compiles, and tools/jdk25.sh puts a 25 there
  (implementation plan P0-02e).
-->
<toolchains>
  <toolchain>
    <type>jdk</type>
    <provides><version>25</version><vendor>openjdk</vendor></provides>
    <configuration><jdkHome>/usr/lib/jvm/java-25-openjdk-amd64</jdkHome></configuration>
  </toolchain>
</toolchains>
