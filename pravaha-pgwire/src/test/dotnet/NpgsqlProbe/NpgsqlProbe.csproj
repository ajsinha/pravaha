  The real .NET PostgreSQL driver, driven against pravaha-pgwire by NpgsqlClientTest. Npgsql 4.0.17
  is pinned because it is the version Power BI Desktop bundles (since the October 2024 release) and
  the on-premises data gateway ships (since June 2025): the one Power BI's PostgreSQL connector
  actually loads. Npgsql 4.1 and later are not what Power BI runs, so passing against them would
  prove nothing about Power BI. Built by the test into target/, never into this directory.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
    <NoWarn>NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="4.0.17" />
  </ItemGroup>
</Project>
