<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.2.1-SNAPSHOT</version>
  </parent>
  <artifactId>pravaha-backfill</artifactId>
  <name>Pravaha :: backfill</name>
  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-state</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- CapturingRowWriter, so a splice test can assert the rows rather than a count of them. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Error Prone and NullAway gate this module (-Pep). It was brought to zero findings (NullAway,
       Error Prone's WARNING checks and javac's -Xlint) and is held there: NullAway at ERROR, and any
       warning at all fails the compile, main and test code alike. -->
  <profiles>
    <profile>
      <id>ep</id>
      <properties>
        <ep.nullaway.level>ERROR</ep.nullaway.level>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <failOnWarning>true</failOnWarning>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
