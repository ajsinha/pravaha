<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.4.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>pravaha-sdk-java</artifactId>
  <name>Pravaha :: sdk :: java</name>
  <description>Java client SDK. Depends on pravaha-api only, so adding a Pravaha client to an application
    pulls in no engine, no Netty, no Calcite and no storage clients.</description>

  <properties>
    <!-- Java 21 class files, as every module (ADR-062): a client application needs JDK 21 or
         later. It targeted 17 in 1.x, as pravaha-api did, and 25 in 2.0-2.2 (ADR-061). -->
    <jacoco.line.coverage>0.80</jacoco.line.coverage>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      JSpecify's @Nullable, compile-only. NullAway reads it to check this module; javadoc and an IDE
      show it; and it is RUNTIME-retained, so a tool reflecting over the classes sees it when the jar
      is present, and a JVM loading them without it simply finds no annotation, which the JLS
      guarantees is harmless. So it is not passed on to a client: provided scope adds nothing to an
      application's dependency tree (the SDK stays standalone, SdkIndependenceTest), and a Kotlin or
      NullAway user who wants the nullness can add the 4 KB, dependency-free jar themselves.
    -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-thin-client</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>io.netty:*</exclude>
                    <exclude>org.apache.calcite:*</exclude>
                    <exclude>org.rocksdb:*</exclude>
                    <exclude>org.agrona:*</exclude>
                    <exclude>com.aerospike:*</exclude>
                    <exclude>org.springframework:*</exclude>
                    <exclude>com.ash.messaging:pravaha-runtime</exclude>
                    <exclude>com.ash.messaging:pravaha-common</exclude>
                  </excludes>
                  <message>The client SDK must stay thin. It is embedded in someone else's application,
                    and every transitive dependency it adds is one their build has to reconcile.
                    Transport libraries belong behind an optional module, not on the default path.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Implementation-Title>Pravaha Java SDK</Implementation-Title>
              <Implementation-Vendor>Ashutosh Sinha</Implementation-Vendor>
              <Implementation-Version>${project.version}</Implementation-Version>
              <Specification-Vendor>Ashutosh Sinha</Specification-Vendor>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <doclint>none</doclint>
          <quiet>true</quiet>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Error Prone and NullAway gate this module (-Pep). It was brought to zero findings (NullAway,
       Error Prone's WARNING checks and javac's -Xlint) and is held there: NullAway at ERROR, and any
       warning at all fails the compile, main and test code alike. The rest of the reactor keeps the
       parent's WARN until it is clean too. -->
  <profiles>
    <profile>
      <id>ep</id>
      <properties>
        <ep.nullaway.level>ERROR</ep.nullaway.level>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <failOnWarning>true</failOnWarning>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
