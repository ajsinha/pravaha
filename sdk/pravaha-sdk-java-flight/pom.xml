<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>0.2.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>pravaha-sdk-java-flight</artifactId>
  <name>Pravaha :: sdk :: java :: flight</name>
  <description>The transport for the Java client SDK, kept in a separate artifact on purpose.

    pravaha-sdk-java is embedded in someone else's application and stays dependency-free, because
    every transitive dependency it adds is one their build has to reconcile -- its own enforcer rule
    bans Netty and friends outright. Arrow Flight brings gRPC and Netty with it, so an application
    that wants the wire takes this artifact and an application that only wants the types does not.</description>
  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-sdk-java</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>flight-sql</artifactId>
      <!-- ADR-053: no JNI where Java does the job. TLS runs on the JDK's own engine, identically on
           every platform; BoringSSL's per-platform builds are left out. -->
      <exclusions>
        <exclusion>
          <groupId>io.netty</groupId>
          <artifactId>netty-tcnative-boringssl-static</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-netty</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!--
      Without this, TLS never actually works: gRPC's Netty transport wires an SSL engine through
      netty-tcnative-boringssl-static (already on the classpath via grpc-netty), and that wiring
      reaches into io.netty.channel.unix.UnixChannel regardless of whether a Unix socket is in
      use. Absent this artifact the failure is NoClassDefFoundError during channel setup on
      either side of a real TLS handshake, server or client, surfacing to a caller as a generic,
      unhelpful "io exception" with no indication that a jar is missing. Found only by actually
      connecting a client to a TLS server: every TLS test that existed before this one checked
      configuration validation (readable files, both halves present) and never started a server,
      so the gap had no way to be seen.

      Its version comes from the parent's netty-bom, the Netty pravaha-server ships, like every other
      netty artifact in this module (PKG-4); see the enforcer configuration below.
    -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-unix-common</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-security</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-registry</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-flight</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-serving</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{jacoco.surefire.argLine} -Xss4m --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <configuration>
              <rules>
                <!--
                  Netty, and only Netty, is exempt from requireUpperBoundDeps here (PKG-4). The
                  parent's netty-bom holds every netty artifact at the version pravaha-server ships
                  (Spring Boot's, 4.1.x), so this module's tests run on the Netty the node runs on;
                  Arrow 19's flight-core and arrow-memory-netty ask for 4.2.9, which the rule would
                  otherwise refuse. Every other artifact is still checked. The rule matches
                  groupId:artifactId exactly; these four are the ones Arrow asks for above the pin
                  (2026-09-29), and a new one refuses the build until it is looked at.
                -->
                <requireUpperBoundDeps>
                  <excludes combine.children="append">
                    <exclude>io.netty:netty-buffer</exclude>
                    <exclude>io.netty:netty-common</exclude>
                    <exclude>io.netty:netty-handler</exclude>
                    <exclude>io.netty:netty-transport</exclude>
                  </excludes>
                </requireUpperBoundDeps>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <!--
              Same mechanism pravaha-flight's own pom uses for the Python SDK's plaintext
              cross-language test: writes this module's test classpath to a file so a Python
              test can start TestTlsFlightServerMain, the real PravahaFlightServer with real
              TLS, rather than a Python imitation of it.
            -->
            <id>write-test-classpath</id>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <phase>test-compile</phase>
            <configuration>
              <outputFile>${project.build.directory}/test-classpath.txt</outputFile>
              <includeScope>test</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
