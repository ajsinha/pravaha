<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.3.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>pravaha-sdk-java-flight</artifactId>
  <name>Pravaha :: sdk :: java :: flight</name>
  <description>The transport for the Java client SDK, kept in a separate artifact on purpose.

    pravaha-sdk-java is embedded in someone else's application and stays dependency-free, because
    every transitive dependency it adds is one their build has to reconcile -- its own enforcer rule
    bans Netty and friends outright. Arrow Flight brings gRPC and Netty with it, so an application
    that wants the wire takes this artifact and an application that only wants the types does not.</description>
  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-sdk-java</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      JSpecify's @Nullable, which NullAway reads to check this module. Compile scope, and that is not a
      new dependency for a client: Guava, which Arrow Flight brings, already depends on this very jar
      at compile scope, so every application using this SDK has it today. Declared here so this
      module does not lean on Guava's choice for a jar its own source imports. (pravaha-api and
      pravaha-sdk-java take it compile-only: they have no such path and stay dependency-free.)
    -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>
    <!--
      Compile-only, as Arrow itself takes it: Arrow's class files carry Checker Framework annotations
      (BaseAllocator's @KeyFor), and without their classes javac warns that it cannot read them when
      -Pep's analysis looks at those methods, which the ep profile below turns into a failure. Nothing
      of it reaches a client.
    -->
    <dependency>
      <groupId>org.checkerframework</groupId>
      <artifactId>checker-qual</artifactId>
      <version>3.43.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>flight-sql</artifactId>
      <!-- ADR-053: no JNI where Java does the job. TLS runs on the JDK's own engine, identically on
           every platform; BoringSSL's per-platform builds are left out. -->
      <exclusions>
        <exclusion>
          <groupId>io.netty</groupId>
          <artifactId>netty-tcnative-boringssl-static</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-netty</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!--
      Without this, TLS never actually works: gRPC's Netty transport wires an SSL engine through
      netty-tcnative-boringssl-static (already on the classpath via grpc-netty), and that wiring
      reaches into io.netty.channel.unix.UnixChannel regardless of whether a Unix socket is in
      use. Absent this artifact the failure is NoClassDefFoundError during channel setup on
      either side of a real TLS handshake, server or client, surfacing to a caller as a generic,
      unhelpful "io exception" with no indication that a jar is missing. Found only by actually
      connecting a client to a TLS server: every TLS test that existed before this one checked
      configuration validation (readable files, both halves present) and never started a server,
      so the gap had no way to be seen.

      Its version comes from the parent's netty-bom, the Netty pravaha-server ships, like every other
      netty artifact in this module (PKG-4); see the enforcer configuration below.
    -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-unix-common</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!--
      Every Netty artifact the transport reaches, named here so an application gets ONE Netty
      (SDKNETTYMIX-1). In this reactor the parent's netty-bom holds them all at ${netty.version}; but
      a dependencyManagement section, the parent's included, governs only the build that declares
      it. An application depending on this artifact resolved Netty by nearest-wins instead: 4.2.9
      netty-common and netty-handler from Arrow, 4.1.130 codecs from grpc-netty, 4.1.135 buffer and
      transport from here; and failed on its first call with an AbstractMethodError inside
      netty-buffer (UnsupportedOperationException from Arrow's allocator on Java 25). The SDK's own
      tests never saw it, because they run in the reactor. A direct dependency is nearer than any
      of those paths, so it decides the version wherever this SDK is used; the versions still come
      from netty-bom. Found by tools/sdk-standalone-check.sh, which builds a client outside the
      repository; a new Netty artifact under Arrow or gRPC belongs in this list.
    -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-common</artifactId>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-buffer</artifactId>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-resolver</artifactId>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport</artifactId>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec</artifactId>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-http</artifactId>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-http2</artifactId>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-handler</artifactId>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-socks</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-handler-proxy</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{jacoco.surefire.argLine} -Xss4m --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <configuration>
              <rules>
                <!--
                  Netty, and only Netty, is exempt from requireUpperBoundDeps here (PKG-4). The
                  parent's netty-bom holds every netty artifact at the version pravaha-server ships
                  (Spring Boot's, 4.1.x), so this module's tests run on the Netty the node runs on;
                  Arrow 19's flight-core and arrow-memory-netty ask for 4.2.9, which the rule would
                  otherwise refuse. Every other artifact is still checked. The rule matches
                  groupId:artifactId exactly; these four are the ones Arrow asks for above the pin
                  (2026-09-29), and a new one refuses the build until it is looked at.
                -->
                <requireUpperBoundDeps>
                  <excludes combine.children="append">
                    <exclude>io.netty:netty-buffer</exclude>
                    <exclude>io.netty:netty-common</exclude>
                    <exclude>io.netty:netty-handler</exclude>
                    <exclude>io.netty:netty-transport</exclude>
                  </excludes>
                </requireUpperBoundDeps>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven.shade.version}</version>
        <executions>
          <execution>
            <id>all-in-one-jar</id>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <!--
                pravaha-sdk-java-flight-<version>-all.jar: this SDK, pravaha-sdk-java, pravaha-api and
                everything they need at run time (Arrow Flight SQL, gRPC, protobuf, Netty, Jackson,
                Guava) in one file, for a client that has no Maven or Gradle and wants
                `java -cp pravaha-sdk-java-flight-<version>-all.jar:. MyClient`. The thin jar stays the
                primary artifact, and its POM is unchanged (no dependency-reduced POM), so a build
                tool still resolves and reconciles the dependencies itself.

                Nothing is relocated, deliberately. The public API hands out Arrow types
                (PravahaFlightClient.connect(options, BufferAllocator)), so relocating Arrow would
                change the SDK's own signatures in this one jar; and gRPC finds its transports,
                name resolvers and load balancers through META-INF/services, Arrow its allocation
                manager by class name, both of which relocation must rewrite perfectly or fail at
                the first call. The price is the usual fat-jar one: an application that already
                has its own gRPC, Netty, Arrow or protobuf on the classpath gets two copies and a
                conflict. Such an application uses the thin jar through its build tool, which is
                the default recommendation (sdk/pravaha-sdk-java/README.md).
              -->
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <!-- gRPC's providers and Arrow's services: merged, never last-one-wins. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <!-- Netty reads its own versions from this file; every netty jar ships one. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/io.netty.versions.properties</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Implementation-Title>Pravaha Java SDK (Flight, all dependencies)</Implementation-Title>
                    <Implementation-Vendor>Ashutosh Sinha</Implementation-Vendor>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <!-- Some of the bundled jars (Jackson, protobuf) are multi-release. -->
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- Signature files from signed dependencies; kept, they fail verification. -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <!-- One jar is one unnamed module; forty module descriptors would be noise. -->
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <doclint>none</doclint>
          <quiet>true</quiet>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The SDK's own tests start a real server in-process, so they need server modules, at test
      scope, which never reaches a client. But Maven's -am follows test-scope dependencies into the
      reactor too, so `-pl sdk/pravaha-sdk-java-flight -am` would build half the engine to package a
      client. tools/build-sdk.sh passes -Dsdk.standalone: these dependencies drop out of the model,
      -am then pulls only pravaha-api and pravaha-sdk-java, and the tests (which cannot compile
      without them) are skipped. Every other build, the gate included, has the property unset and
      runs them as before.
    -->
    <profile>
      <id>sdk-server-tests</id>
      <activation>
        <property>
          <name>!sdk.standalone</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.ash.messaging</groupId>
          <artifactId>pravaha-security</artifactId>
          <version>${project.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>com.ash.messaging</groupId>
          <artifactId>pravaha-registry</artifactId>
          <version>${project.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>com.ash.messaging</groupId>
          <artifactId>pravaha-common</artifactId>
          <version>${project.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>com.ash.messaging</groupId>
          <artifactId>pravaha-flight</artifactId>
          <version>${project.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>com.ash.messaging</groupId>
          <artifactId>pravaha-serving</artifactId>
          <version>${project.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <!--
                  Same mechanism pravaha-flight's own pom uses for the Python SDK's plaintext
                  cross-language test: writes this module's test classpath to a file so a Python
                  test can start TestTlsFlightServerMain, the real PravahaFlightServer with real
                  TLS, rather than a Python imitation of it.
                -->
                <id>write-test-classpath</id>
                <goals>
                  <goal>build-classpath</goal>
                </goals>
                <phase>test-compile</phase>
                <configuration>
                  <outputFile>${project.build.directory}/test-classpath.txt</outputFile>
                  <includeScope>test</includeScope>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>sdk-standalone</id>
      <activation>
        <property>
          <name>sdk.standalone</name>
        </property>
      </activation>
      <properties>
        <maven.test.skip>true</maven.test.skip>
      </properties>
    </profile>
    <!-- Error Prone and NullAway gate this module (-Pep). It was brought to zero findings (NullAway,
         Error Prone's WARNING checks and javac's -Xlint) and is held there: NullAway at ERROR, and any
         warning at all fails the compile, main and test code alike. The rest of the reactor keeps the
         parent's WARN until it is clean too. -->
    <profile>
      <id>ep</id>
      <properties>
        <ep.nullaway.level>ERROR</ep.nullaway.level>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <failOnWarning>true</failOnWarning>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
