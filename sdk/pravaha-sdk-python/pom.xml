<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>pravaha-sdk-python</artifactId>
  <packaging>pom</packaging>
  <name>Pravaha :: sdk :: python</name>
  <description>
    Python client SDK. Built and tested through the reactor under -Ppython so that a Python
    toolchain is not forced on every developer building the engine.
  </description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <jacoco.skip>true</jacoco.skip>
    <spotless.check.skip>true</spotless.check.skip>
    <python.executable>python3</python.executable>
  </properties>

  <profiles>
    <profile>
      <!--
        A developer following the README makes a .venv here, and that is where pytest lives. Without
        this the reactor runs the system python3, finds no pytest, and fails a build that the same
        tests pass in by hand, which reads as a broken build rather than a missing activation.
      -->
      <id>python-venv</id>
      <activation>
        <file><exists>${project.basedir}/.venv/bin/python</exists></file>
      </activation>
      <properties>
        <python.executable>${project.basedir}/.venv/bin/python</python.executable>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>python-test</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${python.executable}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <environmentVariables><PYTHONPATH>src</PYTHONPATH></environmentVariables>
              <arguments>
                <argument>-m</argument><argument>pytest</argument>
                <argument>tests</argument><argument>-q</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>python-wheel</id>
            <phase>package</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${python.executable}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>-m</argument><argument>build</argument>
                <argument>--outdir</argument><argument>${project.build.directory}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
