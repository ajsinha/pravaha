<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.1.0</version>
  </parent>
  <artifactId>pravaha-spring-boot-starter</artifactId>
  <name>Pravaha :: spring boot starter</name>
  <description>Mode B of design 22.2 (ADR-020): an embedded PravahaEngine as a Spring bean, configured from
    pravaha.* properties, with PravahaTemplate and @PravahaListener. A bootstrap layer ABOVE the
    Spring-free engine: it depends on pravaha-embedded, and nothing in the engine depends on it.</description>

  <properties>
    <jacoco.line.coverage>0.75</jacoco.line.coverage>
    <!-- The version pravaha-server is built and tested against. -->
    <spring.boot.version>3.5.16</spring.boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Declared before the Boot BOM, so it wins over it. Boot 3.5 manages jspecify at 1.0.0 and
        the Guava the engine pins (33.7.1, through Calcite) is built against 1.0.1; the enforcer's
        requireUpperBoundDeps refuses the downgrade, correctly: the engine's classpath is the one
        that has to work.
      -->
      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>1.0.1</version>
      </dependency>
      <!--
        The same reason, found by running the Boot 3.2 leg for the first time (a 1.x line; 3.4 is the
        floor from 2.0, and its BOM still downgrades these): Boot 3.2's BOM manages
        commons-dbcp2 at 2.10.0 and HttpClient 5 at 5.2.3 / HttpCore 5 at 5.2.5, below what Calcite
        (dbcp2 2.11.0) and Avatica (httpclient5 5.4.1, httpcore5 5.3.1) are built against, and
        requireUpperBoundDeps refuses the downgrade. Pinned to what Boot 3.5, the server's line,
        resolves, so every leg runs the engine on the classpath the server ships with. They reach
        the engine at runtime only (Calcite's JDBC pooling, Avatica's remote driver), and Boot's own
        HttpComponents support reads the same 5.x API. commons-logging is excluded from dbcp2 as the
        Boot BOM excludes it: spring-jcl provides org.apache.commons.logging in every Boot app.
      -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-dbcp2</artifactId>
        <version>2.13.0</version>
        <exclusions>
          <exclusion>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents.client5</groupId>
        <artifactId>httpclient5</artifactId>
        <version>5.5.2</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5</artifactId>
        <version>5.3.6</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5-h2</artifactId>
        <version>5.3.6</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-embedded</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!--
      Optional: compiled against, never brought in. The actuator contributions switch on only when
      the application has Actuator itself, and @PravahaTest only in a test that already has Boot's
      test stack (spring-boot-starter-test brings all four).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-filesystem</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- BootVersionTest compares this with the Boot actually loaded, so a matrix leg
                 cannot report a version it did not run. -->
            <pravaha.expected.spring.boot.version>${spring.boot.version}</pravaha.expected.spring.boot.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    The Boot matrix (ADR-020): the same tests against the lowest and highest supported Boot 3.x lines.
    With no profile the starter builds against ${spring.boot.version} above, the server's version;
    each profile moves the Boot BOM, and so Spring Framework, Actuator and the test stack with it.

      ./mvnw -pl pravaha-spring-boot-starter -am test -Pboot-3.4
      ./mvnw -pl pravaha-spring-boot-starter -am test -Pboot-3.5

    3.4 is the floor from 2.0 (ADR-061). The starter's classes are Java 25 class files (major 69),
    and the ASM inside Spring Framework 6.0 and 6.1 (Boot 3.2 and 3.3) cannot read them: every
    test errors with "Unsupported class file major version 69" while Boot reads the
    auto-configuration's metadata (2026-10-01, 36 of 38 tests on each line). Their profiles are gone.

    A leg needs its Boot version in the local repository; an offline build of a version that was
    never downloaded fails at resolution, not in a test.
  -->
  <profiles>
    <profile>
      <id>boot-3.4</id>
      <properties>
        <spring.boot.version>3.4.7</spring.boot.version>
      </properties>
    </profile>
    <profile>
      <id>boot-3.5</id>
      <properties>
        <spring.boot.version>3.5.16</spring.boot.version>
      </properties>
    </profile>
  </profiles>
</project>
