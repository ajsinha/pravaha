<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>0.1.3</version>
  </parent>
  <artifactId>pravaha-spring-boot-starter</artifactId>
  <name>Pravaha :: spring boot starter</name>
  <description>Mode B of design 22.2 (ADR-020): an embedded PravahaEngine as a Spring bean, configured from
    pravaha.* properties, with PravahaTemplate and @PravahaListener. A bootstrap layer ABOVE the
    Spring-free engine: it depends on pravaha-embedded, and nothing in the engine depends on it.</description>

  <properties>
    <jacoco.line.coverage>0.75</jacoco.line.coverage>
    <!-- The version pravaha-server is built and tested against. -->
    <spring.boot.version>3.5.16</spring.boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Declared before the Boot BOM, so it wins over it. Boot 3.5 manages jspecify at 1.0.0 and
        the Guava the engine pins (33.7.1, through Calcite) is built against 1.0.1; the enforcer's
        requireUpperBoundDeps refuses the downgrade, correctly: the engine's classpath is the one
        that has to work.
      -->
      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>1.0.1</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-embedded</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!--
      Optional: compiled against, never brought in. The actuator contributions switch on only when
      the application has Actuator itself, and @PravahaTest only in a test that already has Boot's
      test stack (spring-boot-starter-test brings all four).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-filesystem</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- BootVersionTest compares this with the Boot actually loaded, so a matrix leg
                 cannot report a version it did not run. -->
            <pravaha.expected.spring.boot.version>${spring.boot.version}</pravaha.expected.spring.boot.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    The Boot matrix (ADR-020): the same tests against the lowest and highest supported Boot 3.x lines.
    With no profile the starter builds against ${spring.boot.version} above, the server's version;
    each profile moves the Boot BOM, and so Spring Framework, Actuator and the test stack with it.

      ./mvnw -pl pravaha-spring-boot-starter -am test -Pboot-3.2
      ./mvnw -pl pravaha-spring-boot-starter -am test -Pboot-3.5

    A leg needs its Boot version in the local repository; an offline build of a version that was
    never downloaded fails at resolution, not in a test.
  -->
  <profiles>
    <profile>
      <id>boot-3.2</id>
      <properties>
        <spring.boot.version>3.2.12</spring.boot.version>
      </properties>
    </profile>
    <profile>
      <id>boot-3.3</id>
      <properties>
        <spring.boot.version>3.3.13</spring.boot.version>
      </properties>
    </profile>
    <profile>
      <id>boot-3.4</id>
      <properties>
        <spring.boot.version>3.4.7</spring.boot.version>
      </properties>
    </profile>
    <profile>
      <id>boot-3.5</id>
      <properties>
        <spring.boot.version>3.5.16</spring.boot.version>
      </properties>
    </profile>
  </profiles>
</project>
