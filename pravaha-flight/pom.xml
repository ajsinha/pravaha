<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>pravaha-flight</artifactId>
  <name>Pravaha :: flight</name>
  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-serving</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>flight-sql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-netty</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            Arrow allocates off-heap through java.nio internals that the module system closes by
            default. Without these, every test fails at class-load with an InaccessibleObjectException
            that says nothing about Arrow. A deployment needs the same flags; they are documented in
            the module's package-info rather than left for somebody to rediscover.
          -->
          <argLine>@{jacoco.surefire.argLine} -Xss4m --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
