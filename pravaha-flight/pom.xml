<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>1.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>pravaha-flight</artifactId>
  <name>Pravaha :: flight</name>
  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-registry</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-serving</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>flight-sql</artifactId>
      <!-- ADR-053: no JNI where Java does the job. TLS runs on the JDK's own engine, identically on
           every platform; BoringSSL's per-platform builds are left out. -->
      <exclusions>
        <exclusion>
          <groupId>io.netty</groupId>
          <artifactId>netty-tcnative-boringssl-static</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-netty</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Without this, grpc-netty's TLS handshake throws NoClassDefFoundError on
         io.netty.channel.unix.UnixChannel from inside SslHandler.setOpensslEngineSocketFd,
         referenced by the tcnative BoringSSL engine even though nothing here uses a Unix domain
         socket. Nothing in this module's own dependency tree pulled it in, so no TLS handshake
         through PravahaFlightServer.encryptedWith could ever complete; only starting a real TLS
         server and connecting a real client (FlightServerTlsEndToEndTest) surfaced it, the same
         way it surfaced in sdk-java-flight, whose pom.xml carries the identical fix at the
         identical version: the parent's netty-bom, which is the Netty pravaha-server ships (PKG-4). -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-unix-common</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            Arrow allocates off-heap through java.nio internals that the module system closes by
            default. Without these, every test fails at class-load with an InaccessibleObjectException
            that says nothing about Arrow. A deployment needs the same flags; they are documented in
            the module's package-info rather than left for somebody to rediscover.
          -->
          <argLine>@{jacoco.surefire.argLine} -Xss4m --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <configuration>
              <rules>
                <!--
                  Netty, and only Netty, is exempt from requireUpperBoundDeps here (PKG-4). The
                  parent's netty-bom holds every netty artifact at the version pravaha-server ships
                  (Spring Boot's, 4.1.x), so this module's tests run on the Netty the node runs on;
                  Arrow 19's flight-core and arrow-memory-netty ask for 4.2.9, which the rule would
                  otherwise refuse. Every other artifact is still checked. The rule matches
                  groupId:artifactId exactly; these four are the ones Arrow asks for above the pin
                  (2026-09-29), and a new one refuses the build until it is looked at.
                -->
                <requireUpperBoundDeps>
                  <excludes combine.children="append">
                    <exclude>io.netty:netty-buffer</exclude>
                    <exclude>io.netty:netty-common</exclude>
                    <exclude>io.netty:netty-handler</exclude>
                    <exclude>io.netty:netty-transport</exclude>
                  </excludes>
                </requireUpperBoundDeps>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <!--
              Writes this module's test classpath to a file so the Python SDK's tests can start the
              real server rather than a Python imitation of it. Without it those tests skip, and a
              skipped cross-language test looks exactly like a passing one in the summary line.
            -->
            <id>write-test-classpath</id>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <phase>test-compile</phase>
            <configuration>
              <outputFile>${project.build.directory}/test-classpath.txt</outputFile>
              <includeScope>test</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
