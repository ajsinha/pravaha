<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>pravaha-flight</artifactId>
  <name>Pravaha :: flight</name>
  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-registry</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-serving</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>flight-sql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-netty</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Without this, grpc-netty's TLS handshake throws NoClassDefFoundError on
         io.netty.channel.unix.UnixChannel from inside SslHandler.setOpensslEngineSocketFd,
         referenced by the tcnative BoringSSL engine even though nothing here uses a Unix domain
         socket. Nothing in this module's own dependency tree pulled it in, so no TLS handshake
         through PravahaFlightServer.encryptedWith could ever complete; only starting a real TLS
         server and connecting a real client (FlightServerTlsEndToEndTest) surfaced it, the same
         way it surfaced in sdk-java-flight, whose pom.xml carries the identical fix at the
         identical version, pinned to flight-core's own transitive netty-handler version to
         satisfy requireUpperBoundDeps. -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-unix-common</artifactId>
      <version>4.2.9.Final</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            Arrow allocates off-heap through java.nio internals that the module system closes by
            default. Without these, every test fails at class-load with an InaccessibleObjectException
            that says nothing about Arrow. A deployment needs the same flags; they are documented in
            the module's package-info rather than left for somebody to rediscover.
          -->
          <argLine>@{jacoco.surefire.argLine} -Xss4m --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <!--
              Writes this module's test classpath to a file so the Python SDK's tests can start the
              real server rather than a Python imitation of it. Without it those tests skip, and a
              skipped cross-language test looks exactly like a passing one in the summary line.
            -->
            <id>write-test-classpath</id>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <phase>test-compile</phase>
            <configuration>
              <outputFile>${project.build.directory}/test-classpath.txt</outputFile>
              <includeScope>test</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
