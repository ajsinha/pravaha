<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>pravaha-server</artifactId>
  <name>Pravaha :: server</name>
  <description>The engine node: a Spring Boot application serving the public REST API, and a minimal
    server-rendered status page that works when the console process is down.</description>

  <properties>
    <jacoco.line.coverage>0.65</jacoco.line.coverage>
    <spring.boot.version>3.5.16</spring.boot.version>
    <springdoc.version>2.9.1</springdoc.version>
    <!--
      Spring Boot's BOM and Arrow Flight's gRPC stack each pin Netty, and they disagree. Flight is
      the one that has to work: it is the wire protocol, and a Netty mismatch there shows up as a
      connection that fails during the handshake rather than as a missing class at startup. Pinned
      to the version Flight is built against.
    -->
    <netty.version>4.1.130.Final</netty.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-codegen</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-sql</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-flight</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-pgwire</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-registry</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-serving</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-cluster</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-bindings</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-embedded</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-filesystem</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <!--
      Required for TLS on Flight, and absent until a QA pass went looking for it.

      gRPC's SSL handler reaches io.netty.channel.unix.UnixChannel, which lives in this artifact and
      in no other netty jar on this classpath. Without it a TLS node starts, logs that it is serving
      TLS, binds its port, and answers nobody: every connection dies with NoClassDefFoundError while
      the SSL handler is stripped from the pipeline. The only way back to a working deployment is to
      switch TLS off, which is how a fleet ends up authenticated over plaintext.

      Declared here rather than in pravaha-flight because this is the module where netty is pinned by
      hand and requireUpperBoundDeps is deliberately skipped, for exactly this conflict. In
      pravaha-flight the same declaration is a downgrade against Arrow's own graph and the enforcer
      refuses it, correctly.
    -->
    <!--
      application.yaml has exposed /actuator/prometheus since it was written, and the endpoint
      returned 404 because nothing provided the registry behind it. Configuration that advertises a
      scrape target which does not exist is worse than none: a monitoring setup is built against it,
      reports no data, and the absence looks like a quiet system.
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-unix-common</artifactId>
      <version>4.1.135.Final</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <configuration>
              <!--
                Skipped in this module alone, and only because of Netty.

                requireUpperBoundDeps is on everywhere else and has already caught nine real
                version skews. Here it cannot help: Arrow Flight is built against Netty's 4.1
                line, Spring Boot's BOM reaches into 4.2, and the netty.version property above
                pins 4.1.130 by hand for exactly that reason. A rule reading "4.2.9 is larger
                than 4.1.130" would settle the disagreement by upgrading the wire protocol
                across a major line, and a Netty mismatch appears as a connection failing
                mid-handshake, which is a worse thing to debug than a build error.

                Scoped to this module rather than added as a wildcard exclude in the parent, so
                the exception covers Netty here and nothing anywhere else.
              -->
              <skip>true</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <executions>
          <execution>
            <id>executable-jar</id>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <!--
                An executable jar, because until now there was none.

                The quickstart told a reader to run `pravaha-server &` and the build produced a
                plain jar with no manifest main class and no dependencies, so the only way to
                start this server was to assemble a classpath by hand. That is not a packaging
                nicety: it is the difference between software somebody can install and software
                somebody can compile.

                classifier, so the plain jar keeps its coordinates for modules that depend on
                this one. A repackaged jar on a compile classpath puts every dependency inside
                BOOT-INF where javac cannot see it.
              -->
              <classifier>app</classifier>
              <mainClass>com.ash.messaging.pravaha.server.PravahaServerApplication</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
