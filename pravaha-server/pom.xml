<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>pravaha-server</artifactId>
  <name>Pravaha :: server</name>
  <description>The engine node: a Spring Boot application serving the public REST API, and a minimal
    server-rendered status page that works when the console process is down.</description>

  <properties>
    <jacoco.line.coverage>0.65</jacoco.line.coverage>
    <spring.boot.version>3.5.16</spring.boot.version>
    <springdoc.version>2.9.1</springdoc.version>
    <!--
      Netty is not set here. Spring Boot's BOM, imported below, decides it (4.1.135 for 3.5.16), and
      the parent imports the same version as netty-bom so the Flight modules test on the Netty this
      jar ships (PKG-4). A netty.version property here would govern nothing: an imported BOM does
      not read the importing pom's properties.
    -->
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Four artifacts Spring Boot's BOM manages below what another path on this module's
        classpath asks for (SERVERSKEW-1). Each is pinned up to the highest version requested, which
        is what requireUpperBoundDeps demands; entries declared here win over the imported BOM.
        jackson-dataformat-yaml 2.22.1 (swagger-core asks; Boot says 2.21.4) matches the
        jackson-core and -databind the parent pins, so the Jackson set is one version again.
        commons-lang3 3.20.0 (springdoc and swagger-core ask; Boot says 3.17.0). HdrHistogram
        2.2.2 (micrometer asks; the Cassandra driver's 2.1.12 was nearer and won). jspecify
        1.0.1 (Guava asks; Boot says 1.0.0). All four are backward-compatible minor or patch steps.
      -->
      <dependency>
        <groupId>com.fasterxml.jackson.dataformat</groupId>
        <artifactId>jackson-dataformat-yaml</artifactId>
        <version>2.22.1</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>3.20.0</version>
      </dependency>
      <dependency>
        <groupId>org.hdrhistogram</groupId>
        <artifactId>HdrHistogram</artifactId>
        <version>2.2.2</version>
      </dependency>
      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>1.0.1</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-codegen</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-sql</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-flight</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-pgwire</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-registry</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-serving</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-identity</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-cluster</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-bindings</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-embedded</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      Every shipped connector is inside the server jar, so `java -jar pravaha-server.jar` can bind any
      of them with nothing to install and no plugin directory to arrange: the owner's decision of
      2026-09-26, for portability. Spring Boot's nested layout is what makes this safe. Each plugin
      jar stays whole under BOOT-INF/lib, so its META-INF/services file survives intact rather than
      being merged over by the next one, which is how a shaded fat jar silently loses plugins, and so do
      the LICENSE and NOTICE files of the third-party libraries it redistributes.

      One classpath means one version of each library. The collision that made that matter was
      Netty: Arrow 19's flight-core asks for 4.2 and the Cassandra driver pulled 4.1, which is why the
      Cassandra plugin uses the driver's shaded artifact. Delta's Hadoop is the shaded
      hadoop-client-runtime for the same reason. ShippedConnectorsTest holds the list.

      Not here: pravaha-cluster-zookeeper, which is a coordinator for multi-node execution (on
      hold, ADR-045) rather than a connector.
    -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-filesystem</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-feedfile</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-delta</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-iceberg</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-kafka</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-postgres-cdc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-mysql-cdc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-aerospike</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-cassandra</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      The PostgreSQL driver, in the jar for the same reason as the connectors. postgres-cdc declares
      it `provided`, meaning the deployment supplies it; and under `java -jar` with no plugin
      directory a deployment cannot supply anything, so the plugin would have loaded and then failed
      at its first connection. BSD-2 licensed, about a megabyte, and it makes `jdbc` work against
      PostgreSQL with nothing added. Other databases' drivers are not bundled: several are GPL or
      carry their vendor's terms, which a proprietary distribution cannot simply redistribute.
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <!-- The version postgres-cdc's own tests run against, not Spring Boot's managed one: what
           ships should be what was tested. -->
      <version>42.7.8</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <!--
      Required for TLS on Flight, and absent until a QA pass went looking for it.

      gRPC's SSL handler reaches io.netty.channel.unix.UnixChannel, which lives in this artifact and
      in no other netty jar on this classpath. Without it a TLS node starts, logs that it is serving
      TLS, binds its port, and answers nobody: every connection dies with NoClassDefFoundError while
      the SSL handler is stripped from the pipeline. The only way back to a working deployment is to
      switch TLS off, which is how a fleet ends up authenticated over plaintext.

      Declared here as well as in pravaha-flight because nothing on this module's own path to Flight
      brings it at runtime. Its version is Spring Boot's Netty, like every other netty artifact here.
    -->
    <!--
      application.yaml has exposed /actuator/prometheus since it was written, and the endpoint
      returned 404 because nothing provided the registry behind it. Configuration that advertises a
      scrape target which does not exist is worse than none: a monitoring setup is built against it,
      reports no data, and the absence looks like a quiet system.
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!--
      Tracing (off by default; pravaha.tracing.enabled). Micrometer Tracing is the facade Spring Boot's
      own HTTP observations already speak, and the OpenTelemetry bridge turns its spans into OTLP. Both
      versions come from Spring Boot's BOM. Pure Java, so ADR-053 has nothing to say about them.

      The OTLP exporter's default transport is OkHttp, which brings Kotlin's standard library with it;
      it is excluded, and the exporter sends over the JDK's own HttpClient instead
      (opentelemetry-exporter-sender-jdk). One HTTP client fewer, and no Kotlin in a Java server.
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
      <exclusions>
        <exclusion>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-exporter-sender-okhttp</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-sender-jdk</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-unix-common</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            The flags bin/pravaha-server starts the node with, so a test that reads a view back over
            Flight (TracingTest) runs the node the way a deployment does. Arrow writes a batch through
            java.nio internals the module system closes by default; without these the stream is
            cancelled mid-answer with "sun.misc.Unsafe or java.nio.DirectByteBuffer not available".
          -->
          <argLine>@{jacoco.surefire.argLine} -Xss4m --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <configuration>
              <rules>
                <!--
                  Netty, and only Netty, is exempt from requireUpperBoundDeps here, as in the
                  Flight modules (PKG-4). Spring Boot's BOM decides this module's Netty (4.1.x),
                  while Arrow 19's flight-core and arrow-memory-netty ask for 4.2.9. A rule
                  reading "4.2.9 is larger than 4.1.135" would settle that by moving the Flight
                  transport across a major line beside a Spring Boot that is not on it, and a
                  Netty mismatch appears as a connection failing mid-handshake. Every other
                  artifact is checked; the four non-Netty skews the old skip hid are pinned in
                  this pom's dependencyManagement (SERVERSKEW-1).
                -->
                <requireUpperBoundDeps>
                  <excludes combine.children="append">
                    <exclude>io.netty:netty-buffer</exclude>
                    <exclude>io.netty:netty-common</exclude>
                    <exclude>io.netty:netty-handler</exclude>
                    <exclude>io.netty:netty-transport</exclude>
                  </excludes>
                </requireUpperBoundDeps>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <executions>
          <execution>
            <id>executable-jar</id>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <!--
                An executable jar, because until now there was none.

                The quickstart told a reader to run `pravaha-server &` and the build produced a
                plain jar with no manifest main class and no dependencies, so the only way to
                start this server was to assemble a classpath by hand. That is not a packaging
                nicety: it is the difference between software somebody can install and software
                somebody can compile.

                classifier, so the plain jar keeps its coordinates for modules that depend on
                this one. A repackaged jar on a compile classpath puts every dependency inside
                BOOT-INF where javac cannot see it.
              -->
              <classifier>app</classifier>
              <mainClass>com.ash.messaging.pravaha.server.PravahaServerApplication</mainClass>
              <!--
                ZIP, so the launcher is Spring Boot's PropertiesLauncher, which honours loader.path.
                The default JAR layout's launcher reads only what is inside the jar, so a JDBC driver
                for a database other than PostgreSQL could not be added at deployment time.
                bin/pravaha-server passes -Dloader.path=$PRAVAHA_HOME/plugins: a jar dropped there
                is on the classpath at the next start, found by ServiceLoader like a bundled one.
                Everything already in the jar loads exactly as before.
              -->
              <layout>ZIP</layout>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
