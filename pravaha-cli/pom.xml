<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>0.2.1-SNAPSHOT</version>
  </parent>
  <artifactId>pravaha-cli</artifactId>
  <name>Pravaha :: cli</name>
  <description>The pravaha-engine command: validate, explain and run with a full engine in-process, no
    Docker and no cluster, so the loop from idea to output is seconds rather than minutes (design 24.1).
    Commands against a running engine are the Python CLI's (pravaha).</description>

  <properties>
    <jacoco.line.coverage>0.70</jacoco.line.coverage>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-codegen</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-sql</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-sdk-java-flight</artifactId>
      <version>${project.version}</version>
      <!-- Test only: pravaha-engine never talks to a server. The error-code cases under qa.errc
           drive in-process Flight servers through the published SDK. -->
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-flight</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-registry</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-serving</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-filesystem</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- A CLI writes to a terminal, not to a log. Without a binding, SLF4J prints three warning
         lines to stderr on every invocation, which is noise in exactly the place a script reads. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            The CLI's acceptance tests start a real Flight server in-process, and Arrow allocates
            off-heap through java.nio internals the module system closes by default. Without these
            the server fails inside putNext with "Unexpected IO Exception" and cancels the stream,
            so the client sees RST_STREAM and nothing explains why. That cost an afternoon of
            looking at the client for a fault that was in the JVM's module configuration.
          -->
          <argLine>@{jacoco.surefire.argLine} -Xss4m --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven.shade.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <!--
                One jar that runs, because the documentation has been telling readers to type
                `pravaha` since the first quickstart and the build produced a plain jar with no
                main class and no dependencies. Every example in the repository assumed a binary
                that did not exist. bin/pravaha-engine launches this jar; the classifier stays `cli`.

                shade rather than Spring Boot's repackage: this module has no Spring, and a
                shaded jar can be launched by `java -jar` or wrapped in a two-line script without
                a custom class loader in the way.
              -->
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>cli</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.ash.messaging.pravaha.cli.PravahaCli</mainClass>
                </transformer>
                <!--
                  Arrow and the plugin layer both ship META-INF/services entries, and a plain
                  overwrite keeps whichever jar happened to be last. That is how source plugin
                  discovery silently stops finding half its plugins.
                -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- Signature files from signed dependencies; kept, they fail verification. -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
