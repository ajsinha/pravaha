<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.2.1-SNAPSHOT</version>
  </parent>
  <artifactId>pravaha-api</artifactId>
  <name>Pravaha :: api</name>
  <description>The public SPI. Zero third-party dependencies (design 7.2); Java 25 class files, like
    every module, from 2.0 (ADR-061).</description>

  <properties>
    <jacoco.line.coverage>0.85</jacoco.line.coverage>
  </properties>

  <!-- No compile dependencies. Enforced below, not merely intended; the one exception is JSpecify's
       annotations, which are compile-only (provided) and so reach neither a plugin nor a client. -->
  <dependencies>
    <!--
      JSpecify's @Nullable, compile-only. NullAway reads it to check this module; javadoc and an IDE
      show it; and it is RUNTIME-retained, so a tool reflecting over the classes sees it when the jar
      is present, and a JVM loading them without it simply finds no annotation, which the JLS
      guarantees is harmless. So it is not passed on to a client: provided scope adds nothing to an
      application's dependency tree (the SDK stays standalone, SdkIndependenceTest), and a Kotlin or
      NullAway user who wants the nullness can add the 4 KB, dependency-free jar themselves.
    -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-zero-compile-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>*:*:*:*:compile</exclude>
                    <exclude>*:*:*:*:runtime</exclude>
                    <exclude>*:*:*:*:provided</exclude>
                  </excludes>
                  <includes>
                    <!-- Annotations only, compile-only: nothing of it is on a plugin's or a client's
                         classpath at run time. -->
                    <include>org.jspecify:jspecify:*:*:provided</include>
                  </includes>
                  <message>pravaha-api must have zero compile/runtime dependencies (design 7.2). It is the
                    only package a plugin sees from its parent classloader and the module under
                    japicmp semver enforcement. Put richer types behind it.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <doclint>none</doclint>
          <quiet>true</quiet>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Error Prone and NullAway gate this module (-Pep). It was brought to zero findings (NullAway,
       Error Prone's WARNING checks and javac's -Xlint) and is held there: NullAway at ERROR, and any
       warning at all fails the compile, main and test code alike. The rest of the reactor keeps the
       parent's WARN until it is clean too. -->
  <profiles>
    <profile>
      <id>ep</id>
      <properties>
        <ep.nullaway.level>ERROR</ep.nullaway.level>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <failOnWarning>true</failOnWarning>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
