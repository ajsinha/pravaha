    {
      "type": "timeseries",
      "title": "Subscriptions ended",
      "description": "Subscriptions the engine ended because the caller was no longer entitled: a credential revoked, a grant withdrawn, a filter or mask changed.",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
