    {
      "type": "timeseries",
      "title": "Grant and policy changes",
      "description": "Changes made to the catalogue on this node, by kind, per hour.",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (increase(pravaha_catalog_changes_total{node=~\"$node\"}[1h]))",
