    {
      "type": "timeseries",
      "title": "Decisions allowed and denied",
      "description": "Every access decision, by outcome.",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (rate(pravaha_catalog_access_decisions_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "range": true
