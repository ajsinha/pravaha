      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(time() - pravaha_query_checkpoint_last_success_timestamp_seconds{node=~\"$node\", query=~\"$query\"})",
          "legendFormat": "",
          "range": true
