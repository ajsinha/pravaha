#!/usr/bin/env bash
# Project Pravaha -- Ask once. Answer always.
# Copyright (c) 2026 Ashutosh Sinha <ajsinha@gmail.com>. All rights reserved.
# Proprietary and confidential; see the LICENSE file in the root of this repository.
#
# pravaha-health: the probe the image's HEALTHCHECK, the compose stack and `helm test` run INSIDE the
# engine's container. Bash and nothing else -- no wget, no curl, no nc.
#
#   bin/pravaha-health                                  # GET :18080/actuator/health/liveness
#   bin/pravaha-health /actuator/health/readiness       # another path; exit 0 on a 2xx
#   bin/pravaha-health --host node --port 18080 --print /api/v1/status   # and print the body
#   bin/pravaha-health --tcp node 19090                 # only: does the port accept a connection
#
# Why a script and not `wget --spider`: the probe used to be wget, which the eclipse-temurin JRE
# images carried -- until the 25 one did not. With JDK 25 the default base, the HEALTHCHECK failed
# with "wget: not found" on a node that was serving perfectly, compose held every dependent service
# back on a node it called unhealthy, and nothing in the image's own smoke run noticed, because that
# probes from the host. What a probe needs from the image is now this file and bash, which the
# launcher already requires. HTTP/1.0 over bash's /dev/tcp: one request, the server closes, no
# chunked body to decode.
set -uo pipefail

host="127.0.0.1"
port="18080"
print=0
timeout_s=3
tcp=0
path="/actuator/health/liveness"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)    host="$2"; shift 2 ;;
    --port)    port="$2"; shift 2 ;;
    --print)   print=1; shift ;;
    --timeout) timeout_s="$2"; shift 2 ;;
    --tcp)     tcp=1; host="$2"; port="$3"; shift 3 ;;
    -h|--help) sed -n '6,13p' "${BASH_SOURCE[0]}"; exit 0 ;;
    /*)        path="$1"; shift ;;
    *) echo "pravaha-health: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

if [[ "$tcp" == 1 ]]; then
  # The connect itself is the check; `timeout` because a filtered port would otherwise hang.
  timeout "$timeout_s" bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null \
    || { echo "pravaha-health: $host:$port does not accept a connection" >&2; exit 1; }
  exit 0
fi

response="$(timeout "$timeout_s" bash -c '
  exec 3<>"/dev/tcp/$1/$2" || exit 1
  printf "GET %s HTTP/1.0\r\nHost: %s\r\nConnection: close\r\n\r\n" "$3" "$1" >&3
  cat <&3
' _ "$host" "$port" "$path" 2>/dev/null)" \
  || { echo "pravaha-health: no answer from http://$host:$port$path" >&2; exit 1; }

status_line="${response%%$'\r'*}"
status_line="${status_line%%$'\n'*}"
code="$(cut -d' ' -f2 <<<"$status_line")"

if [[ "$print" == 1 ]]; then
  # The body is what follows the first blank line.
  body="${response#*$'\r\n\r\n'}"
  printf '%s\n' "$body"
fi

if [[ "$code" =~ ^2[0-9][0-9]$ ]]; then
  exit 0
fi
echo "pravaha-health: http://$host:$port$path answered '${status_line:-nothing}'" >&2
exit 1
