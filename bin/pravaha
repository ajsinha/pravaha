#!/usr/bin/env bash
# Project Pravaha -- Ask once. Answer always.
# Copyright (c) 2026 Ashutosh Sinha <ajsinha@gmail.com>. All rights reserved.
# Proprietary and confidential; see the LICENSE file in the root of this repository.
#
# The command line for a running engine: the Python CLI in sdk/python/pravaha/cli (docs/CLI.md).
# Every example in the documentation types `pravaha`, so this is what makes them true from a
# checkout. The offline Java tool (validate/explain/run with no server) is bin/pravaha-engine.
#
# An installed `pravaha` (pip install "pravaha[flight]") is preferred when there is one that is
# not this script; otherwise the CLI runs from the source tree, with the SDK's own virtualenv
# when it exists (it has pyarrow, which the Flight commands need) and python3 when it does not.
set -euo pipefail

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
root="$(cd "$(dirname "$self")/.." && pwd)"

if [[ -z "${PRAVAHA_CLI_FROM_SOURCE:-}" ]]; then
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    resolved="$(cd "$(dirname "$candidate")" && pwd)/$(basename "$candidate")"
    if [[ "$resolved" != "$self" ]]; then
      exec "$candidate" "$@"
    fi
  done < <(type -ap pravaha 2>/dev/null || true)
fi

python="${PRAVAHA_PYTHON:-}"
if [[ -z "$python" ]]; then
  if [[ -x "$root/sdk/python/.venv/bin/python" ]]; then
    python="$root/sdk/python/.venv/bin/python"
  else
    python="python3"
  fi
fi

export PYTHONPATH="$root/sdk/python${PYTHONPATH:+:$PYTHONPATH}"
exec "$python" -m pravaha.cli "$@"
