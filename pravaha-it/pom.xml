<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.3.1-SNAPSHOT</version>
  </parent>
  <artifactId>pravaha-it</artifactId>
  <name>Pravaha :: it</name>
  <description>Architecture rules and cross-module integration tests. This module holds the checks that
    keep the design's invariants true as the codebase grows.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <!-- JSpecify's nullness annotations, compile-only (see pravaha-api's pom). -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-aerospike</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- ADR-039 item 6: the pushdown equivalence tests run the shipped JDBC source against H2. -->
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-jdbc</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.3.232</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Declared, not inherited: this test writes Aerospike records directly to set up the
           scenario, so it uses the client itself rather than only through the plugin. -->
      <groupId>com.aerospike</groupId>
      <artifactId>aerospike-client-jdk21</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-registry</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-flight</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-serving</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-algebra</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-runtime</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-state</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-catalog</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-connect</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-sql</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-filesystem</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- CrossConnectorJoinTest binds one side of a join to filesystem and the other to
           feedfile, two distinct plugin implementations, so both must be on the classpath.
           No container needed: feedfile's own completion:immediate mode reads a directory once,
           same as filesystem reads a file once. -->
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-plugin-feedfile</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-embedded</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-cli</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Named, not inherited: pravaha-cli (pravaha-engine) no longer carries a client, and the
         end-to-end tests here talk to their nodes through the Java SDK. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-sdk-java-flight</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- PluginSourceFeeds, SourceBinding, PluginSinks and friends: the Spring-free plugin
           bindings the server and the embedded engine share. -->
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-bindings</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The QA conversions in WindowAnswerTest, EventTimeTest, IncrementalTest and
           SubscriptionAnswerTest drive the configured server ingestion path (PluginSourceFeeds
           and SourceBinding), because that is the path a deployment actually has. Test scope:
           this module has no main sources and publishes nothing. -->
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-server</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- FIX-3: the formatter spotless runs, so DebugFixtureExportTest can export a fixture with it
           on the classpath, as the export formats when it can, and prove the file is already in
           the layout spotless:check demands. The same version as the spotless configuration. -->
      <groupId>com.palantir.javaformat</groupId>
      <artifactId>palantir-java-format</artifactId>
      <version>${palantir.format.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec.maven.plugin.version}</version>
        <executions>
          <execution>
            <!--
              The Python SDK's tests, and the console's. Here, in the last module of the reactor,
              because they start the real Java server from this build's classes: bound to the
              aggregator they would run before any of it was compiled, against stale artefacts.
              Skipped unless -Ppython, which sets pravaha.python.tests.
            -->
            <id>python-sdk-test</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <skip>${pravaha.python.tests.skip}</skip>
              <executable>${python.executable}</executable>
              <workingDirectory>${project.basedir}/../sdk/python</workingDirectory>
              <arguments>
                <argument>-m</argument>
                <argument>pytest</argument>
                <argument>tests</argument>
                <argument>-q</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>console-test</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <skip>${pravaha.console.tests.skip}</skip>
              <executable>${console.executable}</executable>
              <workingDirectory>${project.basedir}/../console</workingDirectory>
              <arguments>
                <argument>-m</argument>
                <argument>pytest</argument>
                <argument>tests</argument>
                <argument>-q</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            The same flags as failsafe below, for the unit-phase tests that start a node and read rows
            back over Flight (qa/sql/ContinuousStatementEndToEndTest): an action carries no Arrow
            batch, so tests that only register never needed them, and a DoGet does.
            The jdk.compiler exports are the Palantir formatter's (FIX-3), which parses with javac's
            internals; DebugFixtureExportTest formats a fixture with it.
          -->
          <argLine>@{jacoco.surefire.argLine} -Xss4m --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!--
            Arrow allocates off-heap through java.nio internals the module system closes by default.
            Without these, a Flight server fails inside putNext with "Unexpected IO Exception" and
            cancels the stream, so the client sees RST_STREAM and nothing explains why. pravaha-flight
            sets the same flags for its own tests; an integration test that starts a Flight server
            needs them just as much, and not having them cost an afternoon of looking at the client.
          -->
          <argLine>@{jacoco.surefire.argLine} -Xss4m --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <!-- Testcontainers negotiates Docker API 1.32; Docker 25+ refuse below 1.40 and report
                 it as a missing daemon. 1.40 has been available since Docker 19.03. -->
            <api.version>1.40</api.version>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Error Prone and NullAway gate this module (-Pep). It was brought to zero findings (NullAway,
       Error Prone's WARNING checks and javac's -Xlint) and is held there: NullAway at ERROR, and any
       warning at all fails the compile, main and test code alike. -->
  <profiles>
    <profile>
      <id>ep</id>
      <properties>
        <ep.nullaway.level>ERROR</ep.nullaway.level>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <failOnWarning>true</failOnWarning>
              <compilerArgs combine.children="append">
                <!-- A test-only module has no target/classes, and -Xlint:path says so on every compile. -->
                <arg>-Xlint:-path</arg>
              </compilerArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
