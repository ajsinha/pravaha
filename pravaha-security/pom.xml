<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.1.1-SNAPSHOT</version>
  </parent>
  <artifactId>pravaha-security</artifactId>
  <name>Pravaha :: security</name>
  <description>Who is asking, what they may see, and a record of both.

    Deliberately dependency-free beyond the API: authorization is consulted on the path of every
    query, and a policy that dragged in a framework would put that framework on the hot path of an
    embedded engine.</description>
  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Nullness annotations, compile-time only: provided, so the module stays dependency-free. -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <!-- Error Prone and NullAway gate this module (-Pep). It was brought to zero findings (NullAway,
       Error Prone's WARNING checks and javac's -Xlint) and is held there: NullAway at ERROR, and any
       warning at all fails the compile, main and test code alike. -->
  <profiles>
    <profile>
      <id>ep</id>
      <properties>
        <ep.nullaway.level>ERROR</ep.nullaway.level>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <failOnWarning>true</failOnWarning>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
