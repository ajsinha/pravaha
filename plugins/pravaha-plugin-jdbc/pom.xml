<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.1.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>pravaha-plugin-jdbc</artifactId>
  <name>Pravaha :: plugin :: jdbc</name>
  <description>Incremental-poll source over any JDBC database: a high-water-mark column, a bounded
    query, replayable offsets. The universal fallback for a database with no change feed — and it
    declares what that costs rather than implying a fidelity it does not have. Also a lookup source,
    and a sink that maintains a query's answer in a table, exactly once through a staging table.</description>

  <properties>
    <h2.version>2.3.232</h2.version>
    <jacoco.line.coverage>0.70</jacoco.line.coverage>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- No driver. The deployment supplies its own on the plugin's isolated classpath, which is why
         one connector serves PostgreSQL, MySQL, SQL Server and anything else with a JDBC driver. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Compile scope for the sink: a BYTES column is copied out of the engine's binary row, and a
         DECIMAL's two limbs are reassembled the way the engine wrote them. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The sink's end-to-end tests register a real continuous query writing into H2, with
         checkpoints, through the registry that delivers to sinks in production. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-registry</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.8</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- Testcontainers negotiates Docker API 1.32 and Docker 25 and later refuse anything
                 below 1.40, reporting it as a missing daemon rather than a version handshake.
                 1.40 has been available since Docker 19.03, in 2019. -->
            <api.version>1.40</api.version>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
