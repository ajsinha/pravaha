<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.4.2-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>pravaha-plugin-iceberg</artifactId>
  <name>Pravaha :: plugin :: iceberg</name>
  <description>Apache Iceberg sink. Maintains a continuous query's answer in an Iceberg table on
    iceberg-core and iceberg-parquet, not Spark: one Iceberg commit per checkpoint, exactly once.</description>

  <properties>
    <!-- 1.2.1 because it is the newest Iceberg built on Parquet 1.12.3, the Parquet Delta Kernel 4.0
         uses. The server is one classpath (every shipped plugin is in its jar), so the two table
         formats must agree on one Parquet; a newer Iceberg would move Delta's Parquet under it. -->
    <iceberg.version>1.2.1</iceberg.version>
    <parquet.version>1.12.3</parquet.version>
    <!-- Iceberg declares Hadoop compile-only. HadoopTables and Parquet's writer need it at runtime:
         the shaded client, the same pair delta brings, so it adds nothing to the server (version:
         hadoop.client.version in the root pom). -->
    <!-- ICE-1: Caffeine 3, the version Spring Boot manages for pravaha-server, where this plugin runs.
         Iceberg 1.2.1 was built against 2.9.3 and asks for it; declaring 3 here makes every test of
         this module run on the combination the server ships. IcebergSinkFindingsTest resolves each
         Caffeine member Iceberg's classes call, and writes and reads a table with Iceberg's
         Caffeine-backed manifest cache turned on. Move it with Spring Boot. -->
    <caffeine.version>3.2.4</caffeine.version>
    <!-- ICE-4: Avro is how Iceberg writes its manifests. 1.11.4 is the fixed release of the line
         Iceberg 1.2.1 was built on (1.11.1 has CVE-2024-47561); a 1.12 would be a new minor under a
         library that uses Avro's internals. -->
    <avro.version>1.11.4</avro.version>
    <jacoco.line.coverage>0.80</jacoco.line.coverage>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- For the engine's binary row (a BYTES column) and its decimal halves, as delta-sink. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-core</artifactId>
      <version>${iceberg.version}</version>
      <exclusions>
        <!-- For the REST catalog, which this sink does not use. -->
        <exclusion>
          <groupId>org.apache.httpcomponents.client5</groupId>
          <artifactId>httpclient5</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-parquet</artifactId>
      <version>${iceberg.version}</version>
    </dependency>
    <!-- ICE-1: see caffeine.version. Runtime: nothing here calls Caffeine; Iceberg does. -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
      <version>${caffeine.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- ICE-4: Avro up to the fixed 1.11.4, declared here so it is the nearest, in this module and in
         the server. commons-compress is excluded rather than moved: Avro reaches it only for its
         bzip2 codec, which Iceberg never writes a manifest with (its codecs are gzip, zstd, snappy
         and none; xz is already excluded by Iceberg itself), and the fixed 1.26 line would pull
         a newer commons-io under Calcite's in the server. 1.21 had CVE-2024-25710 and -26308. -->
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
      <version>${avro.version}</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>org.apache.commons</groupId>
          <artifactId>commons-compress</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Compile scope: the generic writer's factory takes Parquet's MessageType. -->
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-column</artifactId>
      <version>${parquet.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client-api</artifactId>
      <version>${hadoop.client.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client-runtime</artifactId>
      <version>${hadoop.client.version}</version>
    </dependency>
    <!-- The tests read a table back through Iceberg's own reader, deletes applied. -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-data</artifactId>
      <version>${iceberg.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Error Prone and NullAway gate this module (-Pep). It was brought to zero findings (NullAway,
       Error Prone's WARNING checks and javac's -Xlint) and is held there: NullAway at ERROR, and any
       warning at all fails the compile, main and test code alike. -->
  <profiles>
    <profile>
      <id>ep</id>
      <properties>
        <ep.nullaway.level>ERROR</ep.nullaway.level>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <failOnWarning>true</failOnWarning>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
