<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.4.1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>pravaha-plugin-delta</artifactId>
  <name>Pravaha :: plugin :: delta</name>
  <description>Delta Lake source and sink. The source reads a table's transaction log and turns the
    difference between two versions into Z-set weights, which is the shape Delta's file-level rewrite
    semantics already have. The sink maintains a continuous query's answer in a table, one Delta commit
    per checkpoint. Both built on Delta Kernel, not Spark.</description>

  <properties>
    <!-- Kernel drags in Hadoop and Parquet. That is exactly what plugin classloader isolation
         (ADR-010) exists for, and it is why this weight is acceptable here and nowhere else. -->
    <delta.kernel.version>4.0.0</delta.kernel.version>
    <!-- Kernel's default engine brings hadoop-client-runtime for execution; compiling against
         Configuration needs the API jar as well. Both stay inside this plugin's classloader; their
         version, one for both, is hadoop.client.version in the root pom. -->
    <jacoco.line.coverage>0.55</jacoco.line.coverage>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- JSpecify's nullness annotations, compile-only (see pravaha-api's pom). -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.delta</groupId>
      <artifactId>delta-kernel-api</artifactId>
      <version>${delta.kernel.version}</version>
    </dependency>
    <dependency>
      <groupId>io.delta</groupId>
      <artifactId>delta-kernel-defaults</artifactId>
      <version>${delta.kernel.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client-api</artifactId>
      <version>${hadoop.client.version}</version>
    </dependency>
    <!-- Compile scope for the sink: a BYTES column is copied out of the engine's binary row, and a
         DECIMAL is rebuilt from its two halves, neither of which the generic row exposes. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The sink's end-to-end test registers a real continuous query writing into a Delta table on
         the local filesystem, with checkpoints, through the registry that delivers to sinks in
         production. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-registry</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Error Prone and NullAway gate this module (-Pep). It was brought to zero findings (NullAway,
       Error Prone's WARNING checks and javac's -Xlint) and is held there: NullAway at ERROR, and any
       warning at all fails the compile, main and test code alike. -->
  <profiles>
    <profile>
      <id>ep</id>
      <properties>
        <ep.nullaway.level>ERROR</ep.nullaway.level>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <failOnWarning>true</failOnWarning>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
