<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.4.1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>pravaha-plugin-cassandra</artifactId>
  <name>Pravaha :: plugin :: cassandra</name>
  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- JSpecify's nullness annotations, compile-only (see pravaha-api's pom). -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.cassandra</groupId>
      <artifactId>java-driver-core-shaded</artifactId>
      <exclusions>
        <!--
          jnr-posix is how the driver reads a microsecond clock through JNI, and it arrives with
          jnr-ffi and jffi, whose native jar carries eighteen platform binaries (Linux on x86_64,
          aarch64, arm, i386, mips64el, ppc64, ppc64le, s390x and sparcv9; Windows; SunOS; FreeBSD;
          OpenBSD; DragonFlyBSD). That is 41 MB of closure, and the only JNI in this repository, in
          a deployment whose whole point is one bundle that runs anywhere.

          The driver degrades by itself: with no native clock it uses System.currentTimeMillis() for
          its timestamp generator and logs that once at startup. Pravaha never reads a driver
          timestamp. A row's event time comes from its own column and the watermark from
          WatermarkGenerator, so the resolution lost is resolution nothing here consults.

          Excluded rather than shaded or left alone, and proven by the tests rather than assumed:
          the plugin's unit tests and its Cassandra 4.1 container ITs, the TCK included, pass
          without it.
        -->
        <exclusion>
          <groupId>com.github.jnr</groupId>
          <artifactId>jnr-posix</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- deletes: detect is proved end to end: a registered view over this source, checkpointed and
         restarted, through the registry and source bindings a node uses. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-registry</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-bindings</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>cassandra</artifactId>
      <scope>test</scope>
      <exclusions>
        <!-- The module drags in the DataStax 3.10 driver and, through it, Netty 4.0, for a
             CassandraContainer.getCluster() these tests never call: they connect with the 4.x
             driver the plugin itself uses. The plain 4.x driver used to mask it by winning the
             Netty version; the shaded one carries its own Netty and masks nothing. -->
        <exclusion>
          <groupId>com.datastax.cassandra</groupId>
          <artifactId>cassandra-driver-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- Testcontainers negotiates Docker API 1.32 and Docker 25 and later refuse anything
                 below 1.40, reporting it as a missing daemon rather than a version handshake.
                 1.40 has been available since Docker 19.03, in 2019. -->
            <api.version>1.40</api.version>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Error Prone and NullAway gate this module (-Pep). It was brought to zero findings (NullAway,
       Error Prone's WARNING checks and javac's -Xlint) and is held there: NullAway at ERROR, and any
       warning at all fails the compile, main and test code alike. -->
  <profiles>
    <profile>
      <id>ep</id>
      <properties>
        <ep.nullaway.level>ERROR</ep.nullaway.level>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <failOnWarning>true</failOnWarning>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
