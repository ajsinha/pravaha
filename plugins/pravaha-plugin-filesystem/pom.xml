<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>pravaha-plugin-filesystem</artifactId>
  <name>Pravaha :: plugin :: filesystem</name>
  <description>Delimited-file source and sink. The reference plugin: it has no external dependency, so it
    exercises the SPI without any store getting in the way, and every later plugin is written
    against the shape it establishes.</description>

  <properties>
    <jacoco.line.coverage>0.75</jacoco.line.coverage>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
