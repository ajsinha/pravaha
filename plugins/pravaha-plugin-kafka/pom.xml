<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>0.1.3</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>pravaha-plugin-kafka</artifactId>
  <name>Pravaha :: plugin :: kafka</name>
  <description>A source that reads a Kafka topic, one reader per partition, exactly once from the
    engine's checkpointed offsets; and a sink that writes a continuous query's changes to a topic:
    keyed upserts with tombstones, or an explicit changelog, JSON by default. The sink is exactly once
    to a read_committed consumer, through a staging topic and Kafka transactions tied to the engine's
    checkpoints.</description>

  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Compile scope: a BYTES column is copied out of the engine's binary row, and a DECIMAL's two
         limbs are reassembled the way the engine wrote them. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <exclusions>
        <!--
          The three compression codecs kafka-clients brings are JNI: zstd-jni and snappy-java carry a
          native library per platform (Linux on x86_64, aarch64, arm, ppc64le, s390x, riscv64 and
          more; macOS; Windows; FreeBSD), and lz4-java its own native build beside a Java fallback.
          The client loads a codec only when a batch uses it, so without them it runs as it did:
          compression.type none (the default here) and gzip, which is the JDK's own
          java.util.zip, work; lz4, snappy and zstd are refused by the sink at configuration, with
          PRV-5100, rather than failing at the first batch with a NoClassDefFoundError.

          The same trade the Cassandra plugin made for jnr-posix: one bundle that runs anywhere,
          proven by this module's tests, the real-broker ones included, passing without them.
          A deployment that wants lz4 or zstd puts the codec jar on this plugin's classpath and
          sets kafka.compression.type; the refusal checks for the class, not the name.
        -->
        <exclusion>
          <groupId>com.github.luben</groupId>
          <artifactId>zstd-jni</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.lz4</groupId>
          <artifactId>lz4-java</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.xerial.snappy</groupId>
          <artifactId>snappy-java</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- The source reads JSON with Jackson's streaming parser alone: exact decimals and a record
         never materialised as a tree. The version is the one the root pom pins for the whole build,
         which Arrow, Spring Boot and Hadoop already put on a node's classpath. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <!-- format: protobuf reads a record with DynamicMessage over a FileDescriptorSet the deployment
         supplies, so no generated class and no protoc are needed at run time. Already in the build
         through gRPC and Avatica, and pinned by the root pom so which version is a decision rather
         than a consequence of the dependency tree. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <!-- The end-to-end tests register a real continuous query writing to Kafka, with checkpoints,
         through the registry that delivers to sinks in production. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-registry</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- ...and read from it, through the source and sink bindings a node uses. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-bindings</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
