<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.messaging</groupId>
    <artifactId>pravaha</artifactId>
    <version>2.3.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>pravaha-plugin-kafka</artifactId>
  <name>Pravaha :: plugin :: kafka</name>
  <description>A source that reads a Kafka topic, one reader per partition, exactly once from the
    engine's checkpointed offsets; and a sink that writes a continuous query's changes to a topic:
    keyed upserts with tombstones, or an explicit changelog, JSON by default. The sink is exactly once
    to a read_committed consumer, through a staging topic and Kafka transactions tied to the engine's
    checkpoints.</description>

  <dependencies>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- JSpecify's nullness annotations, compile-only (see pravaha-api's pom). -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Compile scope: a BYTES column is copied out of the engine's binary row, and a DECIMAL's two
         limbs are reassembled the way the engine wrote them. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <exclusions>
        <!--
          ADR-053: native code only where Java cannot do the job. kafka-clients brings three
          compression codecs, all JNI. zstd-jni and snappy-java are the two native families the
          root pom's enforce-portable-native-code rule allows, because Parquet already needs them;
          they are declared below, at the version Parquet's modules resolve, so a Kafka topic and a
          Parquet file are read by the same library. lz4-java would be a third family, which the
          rule refuses: lz4 is refused by the sink at configuration (PRV-5100) and by the source at
          the first lz4 batch (PRV-5107), both naming ADR-053, rather than failing with a
          NoClassDefFoundError.

          snappy-java is excluded here too and declared below, because kafka-clients 3.9.1 asks
          for 1.1.10.5 and the build resolves Parquet's 1.1.10.4 (the root pom's pin): one snappy
          for the whole node. Kafka uses only SnappyInputStream and SnappyOutputStream, unchanged
          across the 1.1.10 line, and KafkaCompressedBrokerTest reads and writes snappy batches
          through a real broker against 1.1.10.4. Raising the root pin to 1.1.10.5 or later
          removes the need for this exclusion.
        -->
        <exclusion>
          <groupId>org.xerial.snappy</groupId>
          <artifactId>snappy-java</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.lz4</groupId>
          <artifactId>lz4-java</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- snappy and zstd, for the source reading a compressed topic and for kafka-sink's
         kafka.compression.type. Compile scope because the sink loads each codec once at
         configuration, so a platform the native library was not built for is refused by name
         before a row moves (ADR-053, DEPLOYMENT.md "Native code"). Versions are the root pom's. -->
    <dependency>
      <groupId>org.xerial.snappy</groupId>
      <artifactId>snappy-java</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.luben</groupId>
      <artifactId>zstd-jni</artifactId>
    </dependency>
    <!-- The source reads JSON with Jackson's streaming parser alone: exact decimals and a record
         never materialised as a tree. The version is the one the root pom pins for the whole build,
         which Arrow, Spring Boot and Hadoop already put on a node's classpath. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <!-- format: protobuf reads a record with DynamicMessage over a FileDescriptorSet the deployment
         supplies, so no generated class and no protoc are needed at run time. Already in the build
         through gRPC and Avatica, and pinned by the root pom so which version is a decision rather
         than a consequence of the dependency tree. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <!-- The end-to-end tests register a real continuous query writing to Kafka, with checkpoints,
         through the registry that delivers to sinks in production. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-registry</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- ...and read from it, through the source and sink bindings a node uses. -->
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-bindings</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ash.messaging</groupId>
      <artifactId>pravaha-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Error Prone and NullAway gate this module (-Pep). It was brought to zero findings (NullAway,
       Error Prone's WARNING checks and javac's -Xlint) and is held there: NullAway at ERROR, and any
       warning at all fails the compile, main and test code alike. -->
  <profiles>
    <profile>
      <id>ep</id>
      <properties>
        <ep.nullaway.level>ERROR</ep.nullaway.level>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <failOnWarning>true</failOnWarning>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
